{
  "name": "abstractcybersim-workbench-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "contracts": "json2ts -i ../packages/contracts/schemas/EpisodeConfig.json -o src/generated/EpisodeConfig.ts && json2ts -i ../packages/contracts/schemas/ExperimentSpec.json -o src/generated/ExperimentSpec.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test:integration": "tsc -p tsconfig.test.json && vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "cytoscape": "^3.30.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/cytoscape": "^3.21.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "json-schema-to-typescript": "^15.0.0",
    "jsdom": "26.1.0",
    "vitest": "3.2.7"
  }
}
